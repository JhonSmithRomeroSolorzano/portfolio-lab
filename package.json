{
  "name": "jhon-portfolio-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "npm run build:resume",
    "dev": "vite --host 127.0.0.1",
    "build:resume": "node --import tsx scripts/build-resume.ts",
    "build:engine": "node --import tsx scripts/build-jet-engine.mjs",
    "build": "npm run typecheck && npm run build:resume && vite build && node --import tsx scripts/prerender.ts && node --import tsx scripts/build-release.ts && node --import tsx scripts/check-assets.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "api": "node --import tsx server/start.ts",
    "replay": "node --import tsx scripts/replay.ts",
    "test:browser": "playwright test",
    "audit:performance": "node scripts/audit-performance.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.domain.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "verify:deployment": "node --import tsx scripts/verify-deployment.ts",
    "audit:ci": "node --import tsx scripts/audit-ci.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lighthouse": "13.5.0",
    "pdfkit": "0.20.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
